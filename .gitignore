# This repo is PUBLIC (GitHub Pages). Only the deployed app files are tracked.
# Business data (production plans, customer names, exported reports) stays local-only.
# Ignore everything by default, then explicitly allow the deploy files.
# NOTE: because of the deny-all rule, every new tracked file needs a line here.
/*
!/.gitignore
!/.gitattributes
!/production_plan_tracker.html
# โค้ดฝั่งเซิร์ฟเวอร์ที่เจ้าของต้องก๊อปไปวางใน Apps Script เอง
# อยู่ใน repo เพื่อให้ตรวจได้ว่าคอลัมน์สองฝั่งตรงกัน — ไม่มี token/URL จริงอยู่ในไฟล์
!/google-apps-script.gs
!/คู่มือติดตั้ง_GoogleSheets.md
!/CLAUDE.md
!/INVARIANTS.md
!/.github/

# Test harness (dev tooling — the app itself still has no build step).
!/tests/
!/package.json
!/playwright.config.js

# Evidence photos pulled from the private intake repo at runtime.
# The deny-all above already covers this; kept explicit so a future
# restructure of this file cannot quietly start tracking them.
/evidence/

# ...but never the generated output of a test run.
/node_modules/
/test-results/
/playwright-report/
/package-lock.json
